# Copy to .env for local runs (never commit .env). On Render, set these as environment variables.
JOB_TOKEN=generate-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ALERT_EMAIL_TO=you@example.com
# ALERT_EMAIL_FROM defaults to Resend's test sender; set your own once you verify a domain
