# Copy to .env (never commit it - it's gitignored) and fill in. Spring Boot does NOT read this file by itself;
# load it into your terminal first:   set -a; source .env; set +a   then   ./mvnw spring-boot:run
# On Render, set the same names under the service's Environment tab instead.

# --- required ---
JOB_TOKEN=change-me-job-token            # cron-job.org sends this as X-Job-Token (openssl rand -hex 16)
DASHBOARD_TOKEN=change-me-dashboard      # you type this into the dashboard login (openssl rand -hex 16)

# --- AI (news scoring, pre-market brief, "Explain with AI") ---
ANTHROPIC_API_KEY=sk-ant-...

# --- alerts (optional; without them alerts only go to the log) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ALERT_EMAIL_TO=you@example.com
# ALERT_EMAIL_FROM defaults to Resend's test sender; set your own once you verify a domain

# --- database (optional locally; without it an in-memory database is used and lost on restart) ---
# DATABASE_URL=jdbc:postgresql://localhost:55432/marketpulse
# DATABASE_USERNAME=mp
# DATABASE_PASSWORD=mp

# --- dashboard on another site (production: your Vercel URL) ---
# DASHBOARD_ORIGINS=https://marketpulse-xyz.vercel.app
